<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="institutions">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="institution" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="id" type="xs:string"/>
							<xs:element name="name" type="xs:string"/>
							<xs:element name="alternativeNames">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="alternativeName" maxOccurs="unbounded" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:choice>
								<xs:sequence>
									<xs:element name="acronyms">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="acronym" type="xs:string"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="location" type="T3_location"/>
									<xs:element name="web" type="T3_web"/>
									<xs:element name="lifecycle" type="T3_lifecycle"/>
									<xs:element name="institutionTypes">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="institutionType" type="xs:string"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="numberOfStudents" type="xs:short"/>
									<xs:element name="memberships">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="membership" maxOccurs="unbounded" type="xs:string"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:sequence>
									<xs:element name="location" type="T3_location"/>
									<xs:element name="web" type="T3_web"/>
									<xs:element name="lifecycle" type="T3_lifecycle"/>
									<xs:element name="qualityAssurance">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="numberOfQAReports" type="xs:byte"/>
												<xs:element name="lastQAReportDate" type="xs:date"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="parentInstitutions" minOccurs="0">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="parentInstitution" maxOccurs="unbounded" type="xs:string"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:choice>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="T3_lifecycle">
		<xs:sequence>
			<xs:element name="foundingYear" type="xs:short"/>
			<xs:choice>
				<xs:sequence>
					<xs:element name="closureYear" type="xs:short"/>
					<xs:element name="history">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="event" type="xs:string"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
				<xs:element name="status" type="xs:string"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="T3_location">
		<xs:sequence>
			<xs:element name="country" type="xs:string"/>
			<xs:choice>
				<xs:sequence>
					<xs:element name="countryCode" type="xs:string"/>
					<xs:element name="region" type="xs:string"/>
					<xs:element name="city" type="xs:string"/>
					<xs:element name="latitude" type="xs:decimal"/>
					<xs:element name="longitude" type="xs:decimal"/>
				</xs:sequence>
				<xs:element name="city" type="xs:string"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="T3_web">
		<xs:sequence>
			<xs:element name="website" type="xs:anyURI"/>
			<xs:element name="domains" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="domain" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
